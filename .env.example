# Copy this file to server/.env (or .env in the repo root) and fill in your own values.
# NEVER commit .env to GitHub - the secret key gives full admin access to your Supabase project.
# On Render/Heroku, don't use a file: set these in the service's Environment settings instead.

# Supabase dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> Secret keys (starts with sb_secret_)
# (Older projects: the legacy service_role key also works, under the name SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Port the Express server listens on locally (Render/Heroku set this for you - don't set it there)
PORT=5001
